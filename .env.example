# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender. Falls back to onboarding@resend.dev (delivers only to your own account email).
RESEND_FROM_EMAIL=hello@example.com
# Customer-facing display name shown in inboxes.
RESEND_FROM_NAME=Mister Car Wash

# Temporal (scheduling). Run `temporal server start-dev` locally.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Production Temporal Cloud only. Its presence also enables TLS.
# TEMPORAL_API_KEY=
